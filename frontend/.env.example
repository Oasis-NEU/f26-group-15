# Copy to .env.local and fill in. Never commit .env files.

# "mock" (default) runs everything in the browser with demo data.
# "http" talks to the FastAPI backend at VITE_API_URL.
VITE_API_MODE=mock
VITE_API_URL=http://localhost:8000

# Supabase project settings > API. Leave empty to run without login.
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
